{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bookchaowalit-backend/platform-security/contracts/security/secret-reference.schema.json",
  "title": "Secret reference",
  "description": "A pointer to a secret held by a provider, in the form provider://path#version. It never carries the secret value. Values are resolved server-side at execution time only and are never returned, logged or audited. Semantic rules beyond JSON Schema (scheme equals provider, no secret-looking literal anywhere) are enforced by scripts/security_contracts.py. Accepted contract for BOO-163 (owner decision 2026-10-16).",
  "x-contract": "platform-security.secret-reference.v1",
  "x-reference-only": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tenant_id", "name", "provider", "ref", "purpose", "privacy_class"],
  "properties": {
    "schema_version": {"const": "platform-security.secret-reference.v1"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "provider": {"enum": ["env", "infisical", "vault", "aws-sm"]},
    "ref": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^(env|infisical|vault|aws-sm)://[A-Za-z0-9][A-Za-z0-9_./-]{0,199}#(v[1-9][0-9]{0,8}|latest)$"
    },
    "purpose": {"type": "string", "pattern": "^[A-Za-z0-9 .,()_-]{1,160}$"},
    "privacy_class": {"const": "secret"},
    "rotated_at": {"type": "string", "format": "date-time"}
  }
}
